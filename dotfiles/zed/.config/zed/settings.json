// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "title_bar": {
    "show_sign_in": false,
  },
  "icon_theme": "Catppuccin Latte",
  "format_on_save": "on",
  "prettier": {
    "allowed": true,
  },
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "cursor_shape": "bar",
  },
  "git_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
  },
  "outline_panel": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "project_panel": {
    "dock": "left",
  },
  "agent": {
    "default_model": {
      "provider": "opencode",
      "model": "zen/gpt-5",
      "enable_thinking": true,
      "effort": "high",
    },
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "diagnostics": {
    "button": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Noctalia Dark",
  },
}
